---
import 'a11y-password-strength-meter/styles.css';
---

<section class="password-demo" aria-labelledby="password-demo-title">
  <div class="demo-heading">
    <p class="eyebrow">Interactive example</p>
    <h3 id="password-demo-title">Protect a community account</h3>
    <p>Type a password to inspect each requirement, then check whether it is ready. This local demo never submits, stores, logs, or sends the value.</p>
  </div>

  <form data-password-strength-demo action="#" method="post" novalidate>
    <div class="field">
      <label for="community-password">Create password</label>
      <input
        id="community-password"
        name="password"
        type="password"
        autocomplete="new-password"
        minlength="12"
        required
        aria-describedby="community-password-help community-password-feedback"
      />
      <p id="community-password-help" class="help">Use at least 12 characters with uppercase and lowercase letters, a number, and a symbol.</p>
    </div>

    <div
      class="meter"
      data-a11y-password-strength-meter
      data-input-id="community-password"
      data-feedback-id="community-password-feedback"
      data-min-length="12"
      data-live-template="Password strength changed to {label}"
      data-progress-label="Community account password strength"
      data-requirements-label="Community account password requirements"
    >
      <p id="community-password-feedback">Password strength: Not rated</p>
      <ul class="a11y-password-strength-meter__requirements" aria-label="Community account password requirements">
        <li data-requirement="length" data-length="12" data-met="false"><span class="a11y-password-strength-meter__requirement-status">Needed</span><span class="a11y-password-strength-meter__requirement-text">At least 12 characters</span></li>
        <li data-requirement="uppercase" data-met="false"><span class="a11y-password-strength-meter__requirement-status">Needed</span><span class="a11y-password-strength-meter__requirement-text">Includes an uppercase letter</span></li>
        <li data-requirement="lowercase" data-met="false"><span class="a11y-password-strength-meter__requirement-status">Needed</span><span class="a11y-password-strength-meter__requirement-text">Includes a lowercase letter</span></li>
        <li data-requirement="number" data-met="false"><span class="a11y-password-strength-meter__requirement-status">Needed</span><span class="a11y-password-strength-meter__requirement-text">Includes a number</span></li>
        <li data-requirement="symbol" data-met="false"><span class="a11y-password-strength-meter__requirement-status">Needed</span><span class="a11y-password-strength-meter__requirement-text">Includes a symbol</span></li>
      </ul>
    </div>

    <div class="actions">
      <button type="submit">Check password</button>
      <button type="reset" class="secondary">Reset example</button>
    </div>
    <p class="demo-status" data-demo-status role="status">No password has been checked.</p>
  </form>
</section>

<script>
  import { createPasswordStrengthMeter, getPasswordStrength } from 'a11y-password-strength-meter';

  const form = document.querySelector('[data-password-strength-demo]');
  if (form instanceof HTMLFormElement) {
    const input = form.querySelector('#community-password');
    const root = form.querySelector('[data-a11y-password-strength-meter]');
    const status = form.querySelector('[data-demo-status]');

    if (input instanceof HTMLInputElement && root instanceof HTMLElement && status instanceof HTMLElement) {
      const meter = createPasswordStrengthMeter(root);

      form.addEventListener('submit', (event) => {
        event.preventDefault();
        const result = getPasswordStrength(input.value, { minLength: 12 });
        if (result.requirements.some(({ met }) => !met)) {
          status.textContent = 'Not ready yet. Meet every listed requirement before continuing.';
          input.focus();
          return;
        }
        status.textContent = 'Ready for server validation. No password was submitted or stored.';
      });

      form.addEventListener('reset', () => {
        requestAnimationFrame(() => {
          meter.update({ announce: false, dispatchChange: false });
          status.textContent = 'Example reset. No password has been checked.';
        });
      });
    }
  }
</script>

<style>
  .password-demo { margin-block: 2rem; padding: clamp(1rem, 3vw, 2rem); border: 1px solid var(--sl-color-gray-5); border-radius: .75rem; background: var(--sl-color-gray-7); }
  .demo-heading { max-width: 44rem; }
  .demo-heading h3 { margin-block: .25rem .5rem; }
  .eyebrow { margin: 0; color: var(--sl-color-accent-high); font-size: .75rem; font-weight: 700; letter-spacing: .08em; text-transform: uppercase; }
  form { display: grid; gap: 1.25rem; max-width: 42rem; margin-block-start: 1.5rem; }
  .field { display: grid; gap: .45rem; }
  label { font-weight: 700; }
  input { width: 100%; padding: .75rem .85rem; color: var(--sl-color-white); background: var(--sl-color-black); border: 1px solid var(--sl-color-gray-4); border-radius: .4rem; font: inherit; }
  input:focus-visible, button:focus-visible { outline: 3px solid #60a5fa; outline-offset: 3px; }
  .help, .demo-status { margin: 0; }
  .help { color: var(--sl-color-gray-2); }
  .meter { padding: 1rem; border: 1px solid var(--sl-color-gray-5); border-radius: .5rem; background: var(--sl-color-gray-6); }
  .actions { display: flex; flex-wrap: wrap; gap: .75rem; }
  .actions button { margin: 0; }
  button { padding: .65rem 1rem; border: 2px solid var(--sl-color-accent-high); border-radius: .4rem; background: var(--sl-color-accent-high); color: var(--sl-color-black); font: inherit; font-weight: 700; cursor: pointer; }
  button.secondary { color: var(--sl-color-white); background: transparent; }
  .demo-status { min-height: 1.5rem; font-weight: 650; }
</style>
