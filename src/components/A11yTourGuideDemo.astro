---
import 'a11y-tour-guide/styles.css';
---

<section class="tour-guide-demo" data-tour-guide-demo aria-labelledby="tour-guide-demo-title">
  <div class="demo-heading">
    <p class="eyebrow">Interactive example</p>
    <h3 id="tour-guide-demo-title">Review a release handoff</h3>
    <p>
      Start a four-stop orientation through a small release workspace. Leave the
      optional automation panel hidden to verify that the tour announces and
      skips an unavailable target without trapping you.
    </p>
  </div>

  <div class="demo-toolbar">
    <button class="demo-primary" type="button" data-tour-demo-start>
      Start handoff tour
    </button>
    <button class="demo-secondary" type="button" data-tour-demo-reset>
      Reset example
    </button>
    <label class="availability-control">
      <input type="checkbox" data-tour-demo-availability />
      Show optional automation panel
    </label>
  </div>

  <p class="demo-status" role="status" aria-live="polite" data-tour-demo-status>
    The optional automation panel is hidden. The tour will announce and skip that stop.
  </p>

  <div class="handoff-workspace" aria-label="Example release handoff workspace">
    <section
      class="workspace-card workspace-card--lead"
      id="tour-guide-demo-overview"
      aria-labelledby="tour-guide-demo-overview-title"
    >
      <p class="workspace-kicker">Release 2.4</p>
      <h4 id="tour-guide-demo-overview-title">Checkout accessibility handoff</h4>
      <p>Give the incoming reviewer a short, optional orientation to the evidence that matters.</p>
    </section>

    <section
      class="workspace-card"
      id="tour-guide-demo-checks"
      aria-labelledby="tour-guide-demo-checks-title"
    >
      <h4 id="tour-guide-demo-checks-title">Readiness checks</h4>
      <ul>
        <li>Keyboard regression recorded</li>
        <li>Zoom and reflow reviewed</li>
        <li>Rollback owner assigned</li>
      </ul>
    </section>

    <section
      class="workspace-card workspace-card--optional"
      id="tour-guide-demo-automation"
      aria-labelledby="tour-guide-demo-automation-title"
      data-tour-demo-optional
      hidden
    >
      <h4 id="tour-guide-demo-automation-title">Automation summary</h4>
      <p>18 automated checks passed. Manual assistive-technology review is still required.</p>
    </section>

    <section
      class="workspace-card"
      id="tour-guide-demo-handoff"
      aria-labelledby="tour-guide-demo-handoff-title"
    >
      <h4 id="tour-guide-demo-handoff-title">Reviewer handoff</h4>
      <dl>
        <div><dt>Owner</dt><dd>Platform team</dd></div>
        <div><dt>Due</dt><dd>Thursday</dd></div>
        <div><dt>Risk</dt><dd>Moderate</dd></div>
      </dl>
    </section>
  </div>
</section>

<script>
  import { TOUR_EVENTS, createTour } from 'a11y-tour-guide';

  const demo = document.querySelector<HTMLElement>('[data-tour-guide-demo]');

  if (demo) {
    const startButton = demo.querySelector<HTMLButtonElement>('[data-tour-demo-start]');
    const resetButton = demo.querySelector<HTMLButtonElement>('[data-tour-demo-reset]');
    const availability = demo.querySelector<HTMLInputElement>('[data-tour-demo-availability]');
    const optionalPanel = demo.querySelector<HTMLElement>('[data-tour-demo-optional]');
    const status = demo.querySelector<HTMLElement>('[data-tour-demo-status]');

    if (startButton && resetButton && availability && optionalPanel && status) {
      const tour = createTour({
        className: 'handoff-tour',
        checklist: true,
        modal: true,
        closeOnEscape: true,
        keyboardNavigation: true,
        showProgress: true,
        steps: [
          {
            id: 'overview',
            target: '#tour-guide-demo-overview',
            title: 'Start with the shared goal',
            content: 'Keep the tour short and let the semantic page content carry the full explanation.',
          },
          {
            id: 'readiness',
            target: '#tour-guide-demo-checks',
            title: 'Review the evidence',
            content: 'Use the checklist in this dialog to mark stops for your own orientation; it does not change the page data.',
          },
          {
            id: 'automation',
            target: '#tour-guide-demo-automation',
            title: 'Check supporting automation',
            content: 'Automated results support the handoff but do not replace manual accessibility review.',
          },
          {
            id: 'handoff',
            target: '#tour-guide-demo-handoff',
            title: 'Finish with ownership',
            content: 'A useful handoff names the owner, deadline, and risk after the evidence has been reviewed.',
          },
        ],
      });

      const setStatus = (message: string) => {
        status.textContent = message;
      };

      availability.addEventListener('change', () => {
        optionalPanel.hidden = !availability.checked;
        setStatus(
          availability.checked
            ? 'The optional automation panel is available and will be included in the tour.'
            : 'The optional automation panel is hidden. The tour will announce and skip that stop.',
        );
      });

      startButton.addEventListener('click', () => {
        setStatus('Tour started. Focus moved into the generated tour dialog.');
        void tour.start().catch(() => {
          setStatus('The tour could not start. Reset the example and try again.');
        });
      });

      tour.on(TOUR_EVENTS.stepChange, ({ step }) => {
        if (step.id === 'handoff' && optionalPanel.hidden) {
          setStatus('The unavailable automation stop was skipped; the tour recovered at Reviewer handoff.');
        } else {
          setStatus(`Tour showing: ${step.title}.`);
        }
      });

      tour.on(TOUR_EVENTS.complete, () => {
        setStatus('Tour completed. Focus returned to the Start handoff tour button.');
      });

      tour.on(TOUR_EVENTS.skip, () => {
        setStatus('Tour skipped. Focus returned to the Start handoff tour button.');
      });

      tour.on(TOUR_EVENTS.close, () => {
        setStatus('Tour closed. Focus returned to the Start handoff tour button.');
      });

      tour.on(TOUR_EVENTS.error, ({ operation }) => {
        setStatus(`The tour closed after an error during ${operation}.`);
      });

      resetButton.addEventListener('click', () => {
        if (tour.isActive()) tour.skip();
        tour.clearCompletedSteps();
        availability.checked = false;
        optionalPanel.hidden = true;
        setStatus('Example reset. The optional automation panel is hidden.');
        startButton.focus();
      });

      document.addEventListener(
        'astro:before-swap',
        () => {
          tour.destroy();
        },
        { once: true },
      );
    }
  }
</script>

<style>
  .tour-guide-demo {
    margin-block: 2rem;
    padding: clamp(1rem, 3vw, 2rem);
    border: 1px solid var(--sl-color-gray-5);
    border-radius: 0.75rem;
    background: var(--sl-color-gray-7);
  }

  .demo-heading {
    max-width: 48rem;
  }

  .demo-heading h3 {
    margin-block: 0.25rem 0.5rem;
  }

  .eyebrow,
  .workspace-kicker {
    margin: 0;
    color: var(--sl-color-accent-high);
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .demo-toolbar {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.75rem 1rem;
    margin-block-start: 1.25rem;
  }

  .demo-primary,
  .demo-secondary {
    min-block-size: 2.75rem;
    margin: 0;
    padding: 0.65rem 1rem;
    border: 2px solid var(--sl-color-accent-high);
    border-radius: 0.45rem;
    font: inherit;
    font-weight: 700;
    cursor: pointer;
  }

  .demo-primary {
    background: var(--sl-color-accent-high);
    color: var(--sl-color-black);
  }

  .demo-secondary {
    background: transparent;
    color: var(--sl-color-white);
  }

  .availability-control {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    min-block-size: 2.75rem;
    font-weight: 650;
    cursor: pointer;
  }

  .availability-control input {
    inline-size: 1.15rem;
    block-size: 1.15rem;
    margin: 0;
  }

  .demo-status {
    min-block-size: 1.5rem;
    margin-block: 1rem;
    font-weight: 650;
  }

  .handoff-workspace {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1rem;
    padding: 1rem;
    border: 1px solid var(--sl-color-gray-5);
    border-radius: 0.65rem;
    background: var(--sl-color-black);
  }

  .workspace-card {
    min-inline-size: 0;
    padding: 1rem;
    border: 1px solid var(--sl-color-gray-5);
    border-radius: 0.55rem;
    background: var(--sl-color-gray-7);
  }

  .workspace-card--lead {
    grid-column: 1 / -1;
    border-inline-start: 0.35rem solid var(--sl-color-accent-high);
  }

  .workspace-card--optional {
    border-style: dashed;
  }

  .workspace-card h4 {
    margin-block: 0.25rem 0.5rem;
  }

  .workspace-card p,
  .workspace-card ul,
  .workspace-card dl {
    margin-block-end: 0;
  }

  .workspace-card ul {
    padding-inline-start: 1.2rem;
  }

  .workspace-card dl {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 0.65rem;
  }

  .workspace-card dl div {
    min-inline-size: 0;
  }

  .workspace-card dt {
    color: var(--sl-color-gray-2);
    font-size: 0.8rem;
    font-weight: 700;
  }

  .workspace-card dd {
    margin: 0.2rem 0 0;
    font-weight: 700;
    overflow-wrap: anywhere;
  }

  .demo-primary:focus-visible,
  .demo-secondary:focus-visible,
  .availability-control input:focus-visible {
    outline: 3px solid var(--sl-color-accent-high);
    outline-offset: 3px;
  }

  :global(.a11y-tour-root.handoff-tour) {
    --a11y-tour-color-surface: #ffffff;
    --a11y-tour-color-text: #172033;
    --a11y-tour-color-muted: #475569;
    --a11y-tour-color-accent: #1d4ed8;
    --a11y-tour-color-border: #172033;
    --a11y-tour-color-overlay: rgb(15 23 42 / 0.76);
    --a11y-tour-radius: 0.75rem;
    --a11y-tour-shadow: 0 1.25rem 3rem rgb(15 23 42 / 0.35);
  }

  @media (max-width: 42rem) {
    .handoff-workspace,
    .workspace-card dl {
      grid-template-columns: 1fr;
    }

    .demo-toolbar {
      align-items: stretch;
      flex-direction: column;
    }
  }
</style>
