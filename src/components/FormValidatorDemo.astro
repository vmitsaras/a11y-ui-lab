---
import 'a11y-form-validator/styles.css';
---

<section class="validator-demo" aria-labelledby="validator-demo-title">
  <div class="demo-heading">
    <p class="eyebrow">Interactive example</p>
    <h3 id="validator-demo-title">Request an accessibility review</h3>
    <p>Try submitting an empty form, an invalid email address, or a message shorter than 20 characters.</p>
  </div>

  <form data-a11y-form-validator-demo data-a11y-form-validator>
    <div class="field">
      <label for="review-name">Name</label>
      <input id="review-name" name="name" autocomplete="name" required data-message-required="Enter your name." />
    </div>

    <div class="field">
      <label for="review-email">Work email</label>
      <input id="review-email" name="email" type="email" autocomplete="email" required />
    </div>

    <fieldset>
      <legend>Review priority</legend>
      <label><input name="priority" type="radio" value="standard" required /> Standard</label>
      <label><input name="priority" type="radio" value="urgent" required /> Urgent</label>
    </fieldset>

    <div class="field">
      <label for="review-details">What should we review?</label>
      <p id="review-details-hint">Include the affected page or flow. Use 20–180 characters.</p>
      <textarea id="review-details" name="details" aria-describedby="review-details-hint" minlength="20" maxlength="180" required data-character-count></textarea>
    </div>

    <div class="actions">
      <button type="submit">Request review</button>
      <button type="reset" class="secondary">Reset example</button>
    </div>
    <p class="demo-status" data-demo-status role="status" aria-live="polite"></p>
  </form>
</section>

<script>
  import { createFormValidator, createNoSummaryPreset } from 'a11y-form-validator';
  import { createErrorSummaryAddon } from 'a11y-form-validator/addons/error-summary';
  import { createCharacterCountAddon } from 'a11y-form-validator/addons/character-count';

  const form = document.querySelector('[data-a11y-form-validator-demo]');
  if (form instanceof HTMLFormElement) {
    const status = form.querySelector('[data-demo-status]');
    const validator = createFormValidator(form, {
      ...createNoSummaryPreset(),
      focusOnError: 'summary',
      addons: [createErrorSummaryAddon(), createCharacterCountAddon({ threshold: 40 })],
    });

    form.addEventListener('submit', (event) => {
      if (!event.defaultPrevented) {
        event.preventDefault();
        if (status) status.textContent = 'Example submitted successfully. No data was sent.';
      }
    });
    form.addEventListener('reset', () => {
      validator.reset();
      if (status) status.textContent = 'Example reset.';
    });
  }
</script>

<style>
  .validator-demo { margin-block: 2rem; padding: clamp(1rem, 3vw, 2rem); border: 1px solid var(--sl-color-gray-5); border-radius: .75rem; background: var(--sl-color-gray-7); --a11y-form-validator-error-color: #b42318; --a11y-form-validator-focus-color: #2563eb; --a11y-form-validator-summary-background: color-mix(in srgb, #b42318 8%, transparent); }
  .demo-heading { max-width: 44rem; }
  .demo-heading h3 { margin-block: .25rem .5rem; }
  .eyebrow { margin: 0; color: var(--sl-color-accent-high); font-weight: 700; text-transform: uppercase; letter-spacing: .08em; font-size: .75rem; }
  form { display: grid; gap: 1.25rem; max-width: 42rem; margin-block-start: 1.5rem; }
  .field { display: grid; gap: .35rem; }
  label, legend { font-weight: 650; }
  input:not([type='radio']), textarea { width: 100%; padding: .7rem .8rem; color: var(--sl-color-white); background: var(--sl-color-black); border: 1px solid var(--sl-color-gray-4); border-radius: .4rem; font: inherit; }
  textarea { min-height: 8rem; resize: vertical; }
  fieldset { display: flex; flex-wrap: wrap; gap: .75rem 1.5rem; padding: 1rem; border: 1px solid var(--sl-color-gray-5); border-radius: .4rem; }
  fieldset legend { padding-inline: .35rem; }
  fieldset label { display: inline-flex; align-items: center; gap: .4rem; font-weight: 500; }
  .field p { margin: 0; color: var(--sl-color-gray-2); font-size: .9rem; }
  .actions { display: flex; flex-wrap: wrap; gap: .75rem; }
  .actions button { margin: 0; }
  button { padding: .65rem 1rem; border: 2px solid var(--sl-color-accent-high); border-radius: .4rem; background: var(--sl-color-accent-high); color: var(--sl-color-black); font: inherit; font-weight: 700; cursor: pointer; }
  button.secondary { background: transparent; color: var(--sl-color-white); }
  button:focus-visible, input:focus-visible, textarea:focus-visible { outline: 3px solid var(--a11y-form-validator-focus-color); outline-offset: 3px; }
  .demo-status { min-height: 1.5rem; margin: 0; font-weight: 650; }
</style>
