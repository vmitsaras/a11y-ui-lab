---
import 'a11y-filter-list/styles.css';
---

<section class="filter-demo a11y-filter-list" aria-labelledby="filter-demo-title">
  <div class="demo-heading">
    <p class="eyebrow">Interactive example</p>
    <h3 id="filter-demo-title">Find an accessibility testing resource</h3>
    <p>Search by topic, choose a resource type, or try the no-results query <code>captions</code>.</p>
  </div>

  <div data-a11y-filter-list data-input="resource-search" data-list="filter-resource-list" data-count="filter-resource-count" data-empty="filter-resource-empty" data-filter-attributes="data-filter-text,data-level">
  </div>

  <form class="a11y-filter-list__search" role="search" data-filter-form>
    <label class="a11y-filter-list__label" for="resource-search">Search resources</label>
    <div class="search-row">
      <input class="a11y-filter-list__input" id="resource-search" type="search" autocomplete="off" placeholder="Try keyboard or forms">
      <button class="a11y-filter-list__reset" type="button" data-filter-clear>Clear</button>
    </div>
  </form>

  <div class="a11y-filter-list__filters" role="group" aria-label="Filter by resource type">
    <button class="a11y-filter-list__filter" type="button" data-filter-category="all" aria-pressed="true">All</button>
    <button class="a11y-filter-list__filter" type="button" data-filter-category="guide" aria-pressed="false">Guides</button>
    <button class="a11y-filter-list__filter" type="button" data-filter-category="checklist" aria-pressed="false">Checklists</button>
    <button class="a11y-filter-list__filter" type="button" data-filter-category="tool" aria-pressed="false">Tools</button>
  </div>

  <p id="filter-summary" class="filter-summary">All resources are shown.</p>
  <button id="filter-summary-clear" class="summary-clear" type="button" hidden>Clear active filters</button>
  <p id="filter-resource-count" class="a11y-filter-list__count" aria-live="polite" aria-atomic="true">Showing all 6 resources</p>

  <ul id="filter-resource-list" class="a11y-filter-list__list a11y-filter-list__grid" aria-label="Accessibility testing resources">
    <li class="a11y-filter-list__card" data-filter-item data-category="guide" data-level="beginner" data-filter-text="keyboard focus visible navigation guide"><strong>Keyboard testing guide</strong><span>Beginner · Guide</span></li>
    <li class="a11y-filter-list__card" data-filter-item data-category="checklist" data-level="beginner" data-filter-text="forms labels errors instructions checklist"><strong>Accessible forms checklist</strong><span>Beginner · Checklist</span></li>
    <li class="a11y-filter-list__card" data-filter-item data-category="tool" data-level="advanced" data-filter-text="contrast colors wcag tool"><strong>Contrast review tool</strong><span>Advanced · Tool</span></li>
    <li class="a11y-filter-list__card" data-filter-item data-category="guide" data-level="advanced" data-filter-text="screen reader announcements live regions guide"><strong>Live-region testing guide</strong><span>Advanced · Guide</span></li>
    <li class="a11y-filter-list__card" data-filter-item data-category="checklist" data-level="intermediate" data-filter-text="zoom reflow responsive checklist"><strong>Zoom and reflow checklist</strong><span>Intermediate · Checklist</span></li>
    <li class="a11y-filter-list__card" data-filter-item data-category="tool" data-level="intermediate" data-filter-text="headings landmarks structure tool"><strong>Page structure inspector</strong><span>Intermediate · Tool</span></li>
  </ul>

  <div id="filter-resource-empty" class="a11y-filter-list__empty" hidden>
    <p>No resources match those filters. Try a shorter query or reset the example.</p>
    <button class="a11y-filter-list__reset" type="button" data-empty-action="reset">Reset search and category</button>
  </div>
</section>

<script>
  import { createFilterList } from 'a11y-filter-list';
  import { createActiveFilterSummary } from 'a11y-filter-list/addons/active-filter-summary';
  import { createEmptyStateActions } from 'a11y-filter-list/addons/empty-state-actions';
  import { createFacetCounts } from 'a11y-filter-list/addons/facet-counts';

  const root = document.querySelector<HTMLElement>('.filter-demo [data-a11y-filter-list]');
  if (root) {
    const filterList = createFilterList(root, {
      countAllTemplate: 'Showing all {total} resources',
      countFilteredTemplate: 'Showing {visible} of {total} resources',
    });
    createActiveFilterSummary(filterList, { target: '#filter-summary', clearButton: '#filter-summary-clear', itemLabel: 'resource' });
    createEmptyStateActions(filterList, { target: '#filter-resource-empty' });
    createFacetCounts(filterList);
  }
</script>

<style>
  .filter-demo { margin-block: 2rem; padding: clamp(1rem, 3vw, 2rem); border: 1px solid var(--sl-color-gray-5); border-radius: .75rem; background: var(--sl-color-gray-7); --a11y-filter-list-filter-bg-active: var(--sl-color-accent-high); --a11y-filter-list-filter-color-active: var(--sl-color-black); --a11y-filter-list-focus-ring: 3px solid #60a5fa; }
  .demo-heading { max-width: 46rem; }
  .demo-heading h3 { margin-block: .25rem .5rem; }
  .eyebrow { margin: 0; color: var(--sl-color-accent-high); font-size: .75rem; font-weight: 700; letter-spacing: .08em; text-transform: uppercase; }
  .search-row { display: flex; gap: .75rem; align-items: stretch; }
  .search-row input { min-width: 0; }
  .search-row button { flex: none; }
  button { margin: 0; }
  .filter-summary { margin-block: .25rem 0; font-weight: 700; }
  .summary-clear { width: fit-content; margin: 0; padding: .25rem 0; border: 0; color: var(--sl-color-accent-high); background: transparent; font: inherit; text-decoration: underline; cursor: pointer; }
  .a11y-filter-list__card { display: grid; gap: .25rem; }
  .a11y-filter-list__card span { color: var(--sl-color-gray-2); font-size: .875rem; }
  .summary-clear:focus-visible { outline: 3px solid #60a5fa; outline-offset: 3px; }
  @media (max-width: 30rem) { .search-row { align-items: stretch; flex-direction: column; } }
</style>
