<section class="draft-demo" aria-labelledby="draft-demo-title">
  <div class="demo-heading">
    <p class="eyebrow">Interactive example</p>
    <h3 id="draft-demo-title">Recover a workshop proposal</h3>
    <p>Save the proposal, prepare conflicting answers, then check the saved draft. The example uses session storage, so its sample data stays in this browser tab and is never sent.</p>
  </div>

  <form data-form-draft-demo data-a11y-form-draft-persistence aria-describedby="draft-demo-privacy">
    <p id="draft-demo-privacy" class="privacy-note">Use sample planning content only. Browser storage is not encrypted, even when it lasts for one session.</p>

    <div class="field">
      <label for="draft-workshop-title">Workshop title</label>
      <input id="draft-workshop-title" name="workshopTitle" value="Inclusive facilitation essentials" />
    </div>

    <div class="field">
      <label for="draft-workshop-format">Session format</label>
      <select id="draft-workshop-format" name="workshopFormat">
        <option value="in-person">In person</option>
        <option value="online" selected>Online</option>
        <option value="hybrid">Hybrid</option>
      </select>
    </div>

    <div class="field">
      <label for="draft-workshop-summary">Proposal summary</label>
      <textarea id="draft-workshop-summary" name="workshopSummary" rows="5">Plan a practical session on inclusive turn-taking, accessible materials, and clear ways to request support.</textarea>
    </div>

    <fieldset>
      <legend>Planning checks</legend>
      <label class="choice">
        <input name="planningChecks" value="captions" type="checkbox" checked />
        Live captions are arranged
      </label>
      <label class="choice">
        <input name="planningChecks" value="materials" type="checkbox" />
        Materials are available in advance
      </label>
    </fieldset>

    <div class="actions">
      <button type="button" data-save-draft>Save draft</button>
      <button type="button" class="secondary" data-prepare-conflict>Prepare different answers</button>
      <button type="button" class="secondary" data-check-draft>Check saved draft</button>
      <button type="button" class="secondary" data-reset-demo>Reset example</button>
    </div>
  </form>

  <div class="status-panel" aria-labelledby="draft-status-title">
    <h4 id="draft-status-title">Draft status</h4>
    <p data-visible-status>Nothing has been saved in this example yet.</p>
    <p class="visually-hidden" data-live-status role="status" aria-atomic="true"></p>
  </div>

  <div class="restore-panel" aria-labelledby="draft-restore-title">
    <h4 id="draft-restore-title">Restore decision</h4>
    <p>After checking, use the native buttons below to restore the saved answers, keep the current answers, or clear the saved draft.</p>
    <div data-restore-prompt></div>
  </div>
</section>

<script>
  import { createDraftPersistence } from 'a11y-form-draft-persistence';
  import { createSessionStorageAdapter } from 'a11y-form-draft-persistence/adapters/session-storage';
  import { createDraftRestorePrompt } from 'a11y-form-draft-persistence/addons/restore-prompt';
  import { createDraftStatus } from 'a11y-form-draft-persistence/addons/status';

  const form = document.querySelector('[data-form-draft-demo]');

  if (form instanceof HTMLFormElement) {
    const title = form.querySelector('#draft-workshop-title');
    const format = form.querySelector('#draft-workshop-format');
    const summary = form.querySelector('#draft-workshop-summary');
    const materials = form.querySelector('input[value="materials"]');
    const saveButton = form.querySelector('[data-save-draft]');
    const conflictButton = form.querySelector('[data-prepare-conflict]');
    const checkButton = form.querySelector('[data-check-draft]');
    const resetButton = form.querySelector('[data-reset-demo]');
    const visibleStatus = document.querySelector('[data-visible-status]');
    const liveStatus = document.querySelector('[data-live-status]');
    const promptContainer = document.querySelector('[data-restore-prompt]');

    if (
      title instanceof HTMLInputElement
      && format instanceof HTMLSelectElement
      && summary instanceof HTMLTextAreaElement
      && materials instanceof HTMLInputElement
      && saveButton instanceof HTMLButtonElement
      && conflictButton instanceof HTMLButtonElement
      && checkButton instanceof HTMLButtonElement
      && resetButton instanceof HTMLButtonElement
      && visibleStatus instanceof HTMLElement
      && liveStatus instanceof HTMLElement
      && promptContainer instanceof HTMLElement
    ) {
      const drafts = createDraftPersistence(form, {
        adapter: createSessionStorageAdapter(),
        autoSave: false,
        expiresAfter: 1000 * 60 * 60 * 2,
        formVersion: 1,
        key: 'a11y-ui-lab:workshop-proposal-demo:v1',
      });

      const statusAddon = createDraftStatus(drafts, {
        element: visibleStatus,
        liveElement: liveStatus,
      });

      const formatter = new Intl.DateTimeFormat('en-GB', {
        dateStyle: 'medium',
        timeStyle: 'short',
      });

      const restorePrompt = createDraftRestorePrompt(drafts, {
        container: promptContainer,
        describeDraft({ conflictCount, expiresAt, updatedAt }) {
          const conflicts = conflictCount === 0
            ? 'The current eligible answers already match this draft.'
            : `Restoring will replace ${conflictCount} current ${conflictCount === 1 ? 'answer' : 'answers'}.`;
          const expiry = expiresAt
            ? ` It expires ${formatter.format(new Date(expiresAt))}.`
            : '';
          return `Saved ${formatter.format(new Date(updatedAt))}. ${conflicts}${expiry}`;
        },
      });

      saveButton.addEventListener('click', () => {
        void drafts.save();
      });

      conflictButton.addEventListener('click', () => {
        title.value = 'Hybrid facilitation practice lab';
        format.value = 'hybrid';
        summary.value = 'Run a smaller practice session with remote participation, shared agendas, and structured feedback.';
        materials.checked = true;
        visibleStatus.textContent = 'Different current answers are ready. Check the saved draft to review the conflict.';
      });

      checkButton.addEventListener('click', async () => {
        const result = await restorePrompt.check();
        visibleStatus.textContent = result.status === 'available'
          ? 'A saved draft is available. Review the restore decision below.'
          : `Saved-draft check: ${result.status}.`;
      });

      resetButton.addEventListener('click', async () => {
        form.reset();
        const result = await drafts.clear();
        await restorePrompt.check();
        visibleStatus.textContent = result.status === 'cleared' || result.status === 'already-empty'
          ? 'Example reset. The visible form and saved draft are clear.'
          : `The form reset, but clearing the saved draft returned: ${result.status}.`;
      });

      void restorePrompt.check();

      document.addEventListener('astro:before-swap', () => {
        restorePrompt.destroy();
        statusAddon.destroy();
        drafts.destroy();
      }, { once: true });
    }
  }
</script>

<style>
  .draft-demo { margin-block: 2rem; padding: clamp(1rem, 3vw, 2rem); border: 1px solid var(--sl-color-gray-5); border-radius: .75rem; background: var(--sl-color-gray-7); }
  .demo-heading { max-width: 48rem; }
  .demo-heading h3 { margin-block: .25rem .5rem; }
  .eyebrow { margin: 0; color: var(--sl-color-accent-high); font-size: .75rem; font-weight: 700; letter-spacing: .08em; text-transform: uppercase; }
  form { display: grid; gap: 1.1rem; max-width: 44rem; margin-block-start: 1.5rem; }
  .privacy-note, .status-panel p, .restore-panel p { margin-block: 0; }
  .privacy-note { padding: .85rem 1rem; border-inline-start: .3rem solid #fbbf24; background: var(--sl-color-gray-6); }
  .field { display: grid; gap: .45rem; }
  label, legend { font-weight: 700; }
  input:not([type='checkbox']), select, textarea { width: 100%; padding: .7rem .8rem; border: 1px solid var(--sl-color-gray-4); border-radius: .4rem; color: var(--sl-color-white); background: var(--sl-color-black); font: inherit; }
  textarea { min-height: 8rem; resize: vertical; }
  fieldset { display: grid; gap: .7rem; padding: 1rem; border: 1px solid var(--sl-color-gray-5); border-radius: .4rem; }
  fieldset legend { padding-inline: .35rem; }
  .choice { display: flex; gap: .6rem; align-items: flex-start; font-weight: 500; }
  .choice input { margin-block-start: .25rem; }
  .actions, :global(.draft-demo .a11y-form-draft-prompt__actions) { display: flex; flex-wrap: wrap; gap: .75rem; }
  button, :global(.draft-demo .a11y-form-draft-prompt__actions button) { min-height: 3rem; margin: 0; padding: .65rem 1rem; border: 2px solid var(--sl-color-accent-high); border-radius: .4rem; color: var(--sl-color-black); background: var(--sl-color-accent-high); font: inherit; font-weight: 700; cursor: pointer; }
  button.secondary { color: var(--sl-color-white); background: transparent; }
  button:focus-visible, input:focus-visible, select:focus-visible, textarea:focus-visible, :global(.draft-demo .a11y-form-draft-prompt__actions button:focus-visible) { outline: 3px solid #60a5fa; outline-offset: 3px; }
  .status-panel, .restore-panel { display: grid; gap: .65rem; max-width: 44rem; margin-block-start: 1.25rem; padding: 1rem; border: 1px solid var(--sl-color-gray-5); border-radius: .5rem; background: var(--sl-color-gray-6); }
  .status-panel h4, .restore-panel h4 { margin: 0; }
  [data-visible-status] { min-height: 1.5rem; font-weight: 650; }
  [data-restore-prompt] { min-height: 1.5rem; }
  :global(.draft-demo [data-restore-prompt] section) { display: grid; gap: .65rem; padding: 1rem; border-inline-start: .3rem solid var(--sl-color-accent-high); background: var(--sl-color-gray-7); }
  :global(.draft-demo [data-restore-prompt] h2) { margin: 0; font-size: 1.15rem; }
  :global(.draft-demo [data-restore-prompt] p) { margin: 0; }
  .visually-hidden { position: absolute; width: 1px; height: 1px; padding: 0; margin: -1px; overflow: hidden; clip-path: inset(50%); white-space: nowrap; border: 0; }
  @media (max-width: 36rem) {
    .actions, :global(.draft-demo .a11y-form-draft-prompt__actions) { align-items: stretch; flex-direction: column; }
    .actions button, :global(.draft-demo .a11y-form-draft-prompt__actions button) { width: 100%; }
  }
  @media (forced-colors: active) {
    input, select, textarea, fieldset, button, .privacy-note, .status-panel, .restore-panel { border-color: CanvasText; }
  }
</style>
